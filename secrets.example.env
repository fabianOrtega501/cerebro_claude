# Template of secrets.env: every key the brain uses, WITHOUT values. This file IS versioned.
# Copy it to secrets.env (chmod 600) and fill in the values. Never put a real value here:
# Doctor checks that no secret value appears in a versioned file.
#
# No credential lives inside a work repo, not even in an ignored file: a bad .gitignore,
# a `git add -f` or a `git clean` is enough to expose or lose it.
#
# Format: KEY=value, one per line, no quotes. The template with every key (no values) is
# secrets.example.env, which IS versioned. Keep both in sync: Doctor warns when they differ.
# Read by brain/lib/secrets.mjs, brain/lib/tickets/brain_secrets.py and the environment
# guard (brain/lib/environments.mjs).

# --- Test users, one pair per project: <PROJECT>_TEST_EMAIL / _PASSWORD ---------------

AIO_TEST_EMAIL=<user@example.com>
AIO_TEST_PASSWORD=<secret>
# Test company of AIO. It identifies a real client, so it lives here and not in the
# exploration memory; imported modules refer to it as $AIO_COMPANY_NAME.
AIO_COMPANY_NAME=<value>
AIO_COMPANY_ID=<value>

AMI_TEST_EMAIL=<user@example.com>
AMI_TEST_PASSWORD=<secret>
# Real companies of the AMI selector. They identify clients; without them the screenshots
# show generic example names.
AMI_COMPANY_A_NAME=<value>
AMI_COMPANY_A_API=<value>
AMI_COMPANY_B_NIT=<value>
AMI_COMPANY_B_NAME=<value>
AMI_COMPANY_B_API=<value>

# Status: own login against public.usuarios. LIMITADO is a user with restricted permissions.
STATUS_TEST_EMAIL=<user@example.com>
STATUS_TEST_PASSWORD=<secret>
STATUS_TEST_LIMITADO_EMAIL=<user@example.com>
STATUS_TEST_LIMITADO_PASSWORD=<secret>

# --- Database servers: DB_<SERVER>_HOST / _PORT / _USERNAME / _PASSWORD -----------------
# Which environments each server hosts is declared in the "servers" block of the
# environment registry (brain/environments.json).

# DESA server: hosts the desa, qa and pre databases.
DB_DESA_HOST=<host or IP>
DB_DESA_PORT=5432
DB_DESA_USERNAME=<user>
DB_DESA_PASSWORD=<secret>

# PROD server: production only.
DB_PROD_HOST=<host or IP>
DB_PROD_PORT=5432
DB_PROD_USERNAME=<user>
DB_PROD_PASSWORD=<secret>

# --- Database names: DB_<PROJECT>_<ENV>, with ENV = DESA, QA, PRE or PROD ---------------

DB_AIO_DESA=<database name>
DB_AIO_QA=<database name>
DB_AIO_PROD=<database name>

DB_AMI_PROD=<database name>

DB_EPSILON_DESA=<database name>
DB_EPSILON_QA=<database name>
DB_EPSILON_PRE=<database name>
DB_EPSILON_PROD=<database name>

DB_STATUS_DESA=<database name>
DB_STATUS_QA=<database name>
DB_STATUS_PROD=<database name>

# --- Ticket systems where the user stories (HU) live -----------------------------------

MANTIS_URL=https://<server>/
MANTIS_API_TOKEN=<secret>
GLPI_URL=https://<server>/
GLPI_USER=<user>
GLPI_PASSWORD=<secret>
