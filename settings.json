{
  "permissions": {
    "allow": [
      "Bash(docker compose *)",
      "Bash(docker-compose ps *)",
      "Bash(grep -rln 'protected $table = '\\\\''menu'\\\\''\\\\|protected $table = \"menu\"' app/)",
      "Bash(grep -rln 'router.push\\\\|$router' resources/js/src/views/Dashboard/)",
      "Bash(xargs -I{} sed -n '{},+8p' resources/js/src/router.js)",
      "Bash(grep -rho 'AppActiveUser[.a-zA-Z]*\\\\|userInfo[.a-zA-Z'\\\\'']*\\\\|getItem\\('\\\\''user[^\\)]*\\)\\\\|$store.state[.a-zA-Z]*[Uu]ser[.a-zA-Z]*' resources/js/src/views resources/js/src/store)"
    ],
    "additionalDirectories": [
      "/datos/proyectos/AIO/aio-app",
      "/datos/proyectos/AIO/aio-backend",
      "/datos/proyectos/app-movil",
      "/datos/proyectos/Epsilon/epsilon",
      "/datos/proyectos/Epsilon/epsilon-backend",
      "/datos/proyectos/status",
      "/datos/proyectos/status-full/status-api",
      "/datos/proyectos/sipa",
      "/datos/proyectos/rutamas-movil",
      "/datos/proyectos/manua-web",
      "/datos/proyectos/manual-tecnico",
      "/datos/proyectos/imagenes_docker"
    ]
  },
  "effortLevel": "medium",
  "includeCoAuthoredBy": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude-upstream-notice.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/docs-on-push.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/i18n-keys-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/brain-unpushed-notice.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/practice-unrecorded-notice.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/i18n-keys-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.mjs\"",
    "padding": 0
  },
  "model": "opus[1m]",
  "env": {
    "STATUS_MANUAL_WEB": "/datos/proyectos/manua-web"
  }
}
